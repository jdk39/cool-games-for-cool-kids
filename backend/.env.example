# Copy this file to .env and fill it in. Never commit .env.
PORT=3000

# From https://dev.twitch.tv/console (register an application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Leave DB_HOST empty to keep lists in memory while testing locally
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=coolgames

# Set to 1 to use fake sample games without IGDB keys
MOCK=0

# Laptop testing only: skip the login check and use a fake user.
# Leave empty on AWS, where every list request must carry a real login token.
AUTH_DISABLED=0
